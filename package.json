    "brace-expansion@^5.0.0": "5.0.12",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.23.13",
