# This course branch must use an isolated project, not the old production data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Official DeepSeek is the default; students never receive this server-only key.
# Do not put real values here. Use an ignored .env.local or hosted secret settings.
EDU_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional explicit rollback/comparison provider. No automatic fallback.
OPENAI_API_KEY=
EDU_OPENAI_MODEL=gpt-5-nano
# Keep false until schema/RLS, staff roles, privacy notice and tests are verified.
EDU_CLASSROOM_ENABLED=false
# Shared classroom guards: 1—32 concurrent calls and 1—10000 attempts per China day.
# Rejections before calling the model do not consume session chat rounds.
EDU_AI_MAX_CONCURRENT=20
EDU_AI_DAILY_REQUEST_LIMIT=1000
